<mxfile host="app.diagrams.net" type="device"><diagram id="binferno-workflow" name="Binferno workflow"><mxGraphModel dx="1120" dy="630" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1120" pageHeight="630" background="#FFFFFF" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Binferno | From mixed DNA to genome bins" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#172B4D;fontSize=28;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="27" width="1048" height="48" as="geometry"/></mxCell><mxCell id="subtitle" value="Goal: sort assembled DNA pieces into groups likely to come from the same genome." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#172B4D;fontSize=17;fontColor=#526174;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="78" width="1048" height="32" as="geometry"/></mxCell><mxCell id="tax" value="&lt;b&gt;Optional: organism labels (taxonomy)&lt;/b&gt;&lt;br&gt;Guide learning OR refine grouping" style="rounded=1;arcSize=14;whiteSpace=wrap;fillColor=#FFF6DF;strokeColor=#D6B656;fontColor=#665020;fontFamily=Helvetica;fontSize=16;html=1;" vertex="1" parent="1"><mxGeometry x="468" y="128" width="400" height="66" as="geometry"/></mxCell><mxCell id="input" value="&lt;b&gt;1  Start with DNA&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Assembled DNA pieces&lt;br&gt;(contigs, FASTA)&lt;br&gt;&lt;br&gt;Read alignments (BAM)&lt;br&gt;show how much DNA&lt;br&gt;was observed&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;verticalAlign=top;spacingTop=19;spacingLeft=9;spacingRight=9;fontFamily=Helvetica;fontSize=16;fontColor=#172B4D;strokeWidth=1.5;fillColor=#F1F5F9;strokeColor=#94A3B8;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="234" width="184" height="234" as="geometry"/></mxCell><mxCell id="features" value="&lt;b&gt;2  Describe each piece&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;DNA letter patterns&lt;br&gt;(sequence composition)&lt;br&gt;&lt;br&gt;Abundance patterns&lt;br&gt;(coverage across samples)&lt;br&gt;&lt;br&gt;Create cropped views&lt;br&gt;for training&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;verticalAlign=top;spacingTop=19;spacingLeft=9;spacingRight=9;fontFamily=Helvetica;fontSize=16;fontColor=#172B4D;strokeWidth=1.5;fillColor=#EAF2FD;strokeColor=#6C8EBF;html=1;" vertex="1" parent="1"><mxGeometry x="252" y="234" width="184" height="234" as="geometry"/></mxCell><mxCell id="learn" value="&lt;b&gt;3  Learn similarities&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Train on related views&lt;br&gt;of the same DNA piece&lt;br&gt;&lt;br&gt;Barlow Twins / SimCLR&lt;br&gt;&lt;br&gt;Build a compact numeric&lt;br&gt;signature (embedding)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;verticalAlign=top;spacingTop=19;spacingLeft=9;spacingRight=9;fontFamily=Helvetica;fontSize=16;fontColor=#172B4D;strokeWidth=1.5;fillColor=#F0EAF7;strokeColor=#9673A6;html=1;" vertex="1" parent="1"><mxGeometry x="468" y="234" width="184" height="234" as="geometry"/></mxCell><mxCell id="group" value="&lt;b&gt;4  Group DNA pieces&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Marker genes provide&lt;br&gt;starting points (seeds)&lt;br&gt;&lt;br&gt;Connect similar signatures&lt;br&gt;and find groups (Leiden)&lt;br&gt;&lt;br&gt;Try multiple settings&lt;br&gt;to create candidate bins&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;verticalAlign=top;spacingTop=19;spacingLeft=9;spacingRight=9;fontFamily=Helvetica;fontSize=16;fontColor=#172B4D;strokeWidth=1.5;fillColor=#EAF2FD;strokeColor=#6C8EBF;html=1;" vertex="1" parent="1"><mxGeometry x="684" y="234" width="184" height="234" as="geometry"/></mxCell><mxCell id="output" value="&lt;b&gt;5  Check &amp; export&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Estimate missing DNA&lt;br&gt;and unwanted mixing&lt;br&gt;&lt;br&gt;Select the best grouping&lt;br&gt;and remove small bins&lt;br&gt;&lt;br&gt;Save genome bins&lt;br&gt;as FASTA files&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;verticalAlign=top;spacingTop=19;spacingLeft=9;spacingRight=9;fontFamily=Helvetica;fontSize=16;fontColor=#172B4D;strokeWidth=1.5;fillColor=#EAF5EA;strokeColor=#82B366;html=1;" vertex="1" parent="1"><mxGeometry x="900" y="234" width="184" height="234" as="geometry"/></mxCell><mxCell id="flow0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#697B90;strokeWidth=2;endArrow=block;endFill=1;defaultLabelBackgroundColor=gap;" edge="1" parent="1" source="input" target="features"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#697B90;strokeWidth=2;endArrow=block;endFill=1;defaultLabelBackgroundColor=gap;" edge="1" parent="1" source="features" target="learn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#697B90;strokeWidth=2;endArrow=block;endFill=1;defaultLabelBackgroundColor=gap;" edge="1" parent="1" source="learn" target="group"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#697B90;strokeWidth=2;endArrow=block;endFill=1;defaultLabelBackgroundColor=gap;" edge="1" parent="1" source="group" target="output"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="taxlearn" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B08A32;strokeWidth=2;endArrow=block;endFill=1;defaultLabelBackgroundColor=gap;dashed=1;" edge="1" parent="1" source="tax" target="learn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="taxgroup" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B08A32;strokeWidth=2;endArrow=block;endFill=1;defaultLabelBackgroundColor=gap;dashed=1;" edge="1" parent="1" source="tax" target="group"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="reduction" value="Optional: simplify signatures with PCA / UMAP before grouping." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#172B4D;fontSize=15;fontColor=#526174;html=1;" vertex="1" parent="1"><mxGeometry x="468" y="484" width="616" height="26" as="geometry"/></mxCell><mxCell id="markers" value="Optional during learning: marker genes help keep different genomes apart." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#172B4D;fontSize=15;fontColor=#526174;html=1;" vertex="1" parent="1"><mxGeometry x="468" y="516" width="616" height="26" as="geometry"/></mxCell><mxCell id="meaning" value="A genome bin is a collection of DNA pieces — an approximate genome, which may still be incomplete." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#172B4D;fontSize=16;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="565" width="1048" height="30" as="geometry"/></mxCell><mxCell id="legend" value="Solid arrows: main workflow     Dashed arrows: optional taxonomy guidance" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#172B4D;fontSize=14;fontColor=#65758B;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="600" width="1048" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
